# ============================================================
#  密钥文件模板
#
#  用法：把本文件复制一份，改名为 .env，然后只填你【实际拥有】的那几行。
#       其余的留着不动，程序会自动跳过没有密钥的厂商。
#
#  三条纪律：
#    1. .env 不要提交到 git（.gitignore 已经把它排除了）
#    2. .env 的内容不要贴进任何聊天窗口、截图或笔记
#    3. 程序只会打印密钥的指纹（末 4 位），用来核对"我填的是哪一把"
#
#  等号两边不要加空格，值不要加引号（加了也能读，但没必要）。
# ============================================================

# 智谱 GLM —— https://open.bigmodel.cn/usercenter/proj-mgmt/apikeys
ZHIPU_API_KEY=

# 阿里通义千问 —— https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# Kimi（月之暗面）—— https://platform.moonshot.cn/console/api-keys
MOONSHOT_API_KEY=

# 火山方舟（豆包）—— https://console.volcengine.com/ark
ARK_API_KEY=

# DeepSeek —— https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
