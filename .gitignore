# 密钥：绝对不能进版本库
.env

# 抓下来的原文和处理缓存：体积大、可重新获取
data/raw/*
data/cache/*
!data/raw/.gitkeep
!data/cache/.gitkeep

# 本地投喂：可能是有版权的文章，不要提交
data/inbox/*
!data/inbox/.gitkeep
!data/inbox/_说明.md

# 标注产物：里面含抓来的文章全文/开头，不要提交
eval/candidates.jsonl
eval/worksheet.md
eval/worksheet-lite.md
# 但 labels.txt 要提交 —— 它只有 id 和你的判断，没有文章正文，
# 而且它是你唯一无法重新生成的东西（重新 sample 会覆盖它）。
# 你的判断值得被版本管理记住。

# 所以不要把本仓库公开推送 —— 或者手动把 body 字段清掉再推。

# 产出：属于"结果"，不属于"代码"
out/digests/*
out/eval/*
out/logs/*
out/results/*
out/review/*
out/ALERT.md
!out/digests/.gitkeep
!out/eval/.gitkeep
!out/logs/.gitkeep
!out/results/.gitkeep
!out/review/.gitkeep

# 探测结果：本机环境的快照，换台机器就不一样了
config/providers.discovered.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini

# 编译后的评估集含【别人的文章正文】，而仓库是公开的，所以不提交它。
# 本地保留即可，随时能重新 compile。
# 真正值得提交的是 eval/labels.txt —— 那是人的判断，不含正文。
eval/eval_set.jsonl
